# ─── Виртуальное окружение ──────────────────────────────────────────────────
.venv/
venv/
env/
ENV/

# ─── Секреты ────────────────────────────────────────────────────────────────
.env
.env.local
*.key

# ─── Рабочие каталоги приложения ────────────────────────────────────────────
.cache/
gradio_tmp/
output/

# ─── Бинарники (FFmpeg скачивается отдельно) ────────────────────────────────
ffmpeg.exe
ffprobe.exe
ffplay.exe
*.exe
*.dll

# ─── Медиа: исходники и готовые клипы ───────────────────────────────────────
*.mp4
*.mkv
*.mov
*.avi
*.webm
*.m4v
*.wav
*.mp3
*.ass

# ─── Служебный мусор ────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.tmp
*.log
.pytest_cache/
.idea/
.vscode/

# ─── Внутренние артефакты инструментов разработки ───────────────────────────
.zwork/

# ─── Что обязано попасть в репозиторий ──────────────────────────────────────
!models/*.onnx
!.env.example
