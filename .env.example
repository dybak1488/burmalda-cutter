# Скопируйте этот файл в .env и вставьте свои ключи.
# Ключи нужны ТОЛЬКО для «Умного LLM-отбора моментов».
# Если оставить поля пустыми — работает встроенный математический скоринг (без интернета).
#
# Приоритет: поле в UI → переменная окружения → .env

# Groq — https://console.groq.com/keys  (модель: llama-3.3-70b-versatile)
GROQ_API_KEY=

# Cerebras — https://cloud.cerebras.ai/  (модель: llama-3.3-70b)
CEREBRAS_API_KEY=

# Google Gemini (OpenAI-совместимый эндпоинт) — https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Локальная Ollama ключ не требует:
#   https://ollama.com  →  ollama pull qwen3:4b
#   Base URL: http://localhost:11434/v1/chat/completions
